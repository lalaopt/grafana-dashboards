    {
      "collapsed": true,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 200,
      "title": "① SLO Latency — A100",
      "type": "row",
      "panels": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "description": "TTFT / TPOT / E2E (선택 분위수)",
          "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 5, "lineWidth": 1}}, "overrides": []},
          "gridPos": {"h": 6, "w": 8, "x": 0, "y": 1},
          "id": 1,
          "maxPerRow": 3,
          "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
          "repeat": "model_a100",
          "repeatDirection": "h",
          "targets": [
            {"expr": "histogram_quantile(${percentile:raw}, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{model=\"$model_a100\",accelerator=\"a100\"}[5m])))", "legendFormat": "TTFT ${percentile:text}", "refId": "A"},
            {"expr": "histogram_quantile(${percentile:raw}, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{model=\"$model_a100\",accelerator=\"a100\"}[5m])))", "legendFormat": "TPOT ${percentile:text}", "refId": "B"},
            {"expr": "histogram_quantile(${percentile:raw}, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{model=\"$model_a100\",accelerator=\"a100\"}[5m])))", "legendFormat": "E2E ${percentile:text}", "refId": "C"}
          ],
          "title": "${model_a100}",
          "type": "timeseries"
        }
      ]
    },
